# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python packaging and build output
.Python
build/
dist/
*.egg-info/
.eggs/

# Test, type-checking, and coverage output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Customer campaign exports and translation bundles must never be committed.
# Keep them outside this directory; these rules are a safety net for root-level
# JSON only (references/*.json stay tracked).
work/
exports/
/*.json

# Temporary and editor files
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*.log
*.bak
*~
.DS_Store
*:Zone.Identifier
